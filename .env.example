# ---- LLM ---------------------------------------------------------------
# gemini = real calls (needs GOOGLE_API_KEY), fake = offline demo / tests
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key   # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ---- Storage -------------------------------------------------------------
# Local default is SQLite. Docker compose overrides this with Postgres.
# DATABASE_URL=postgresql+psycopg2://campaignpilot:campaignpilot@localhost:5432/campaignpilot
# memory | local | http://localhost:6333
QDRANT_URL=local

# ---- Agents --------------------------------------------------------------
# mcp = agents call tools through the MCP server, direct = in-process
TOOLS_MODE=mcp
MAX_REVISIONS=2
REVIEW_PASS_SCORE=7

# ---- Public demo protection (used on Hugging Face Spaces) ----------------
# ACCESS_CODE=pick-a-code        # visitors must enter it before running agents
MAX_RUNS_PER_HOUR=30
# FAKE_LLM_DELAY=1               # offline demo: slow the fake model so progress is visible
